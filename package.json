{
  "name": "campi",
  "version": "0.1.0",
  "description": "Note taking app that has local memory.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "concurrently -n server,client \"npm run dev\" \"npm run dev:client\"",
    "build": "tsc && npm run build:client",
    "build:client": "npm --prefix client run build",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:new": "supabase migration new",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "test": "tsc -p test/tsconfig.json && node --experimental-vm-modules --env-file-if-exists=.env node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "supabase": "^2.118.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
