# Copy to .env and fill in. Never commit .env.

# Local Supabase Postgres (started with `npm run db:start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Hosted Supabase (Dashboard > Connect > connection string), e.g.:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Express "trust proxy" setting. Leave unset locally; set to 1 on Railway
# (one proxy hop) so req.ip is the real client IP for rate limiting.
# TRUST_PROXY=1
